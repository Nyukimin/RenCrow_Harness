{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rencrow:harness:llm-contract:v1",
  "$defs": {
    "RequestID": {
      "type": "string",
      "pattern": "^req_[0-9a-f]{8}-[0-9a-f]{4}-[57][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "RecoveryRequest": {
      "type": "object",
      "properties": {
        "profile_id": {
          "enum": [
            "same_request",
            "terminal_output_once"
          ]
        },
        "profile_revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "retry_of_request_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/RequestID"
            },
            {
              "type": "null"
            }
          ]
        },
        "trigger_code": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "profile_id",
        "profile_revision",
        "retry_of_request_id",
        "trigger_code"
      ],
      "additionalProperties": false
    },
    "GenerationExtension": {
      "type": "object",
      "properties": {
        "contract_version": {
          "const": "harness-v1"
        },
        "stage": {
          "enum": [
            "act",
            "instruction_selection",
            "work_summary"
          ]
        },
        "expected_binding_fingerprint": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "expected_request_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "max_backend_attempts": {
          "const": 1
        },
        "recovery": {
          "$ref": "#/$defs/RecoveryRequest"
        },
        "expected_input_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "contract_version",
        "stage",
        "expected_binding_fingerprint",
        "expected_request_digest",
        "max_backend_attempts",
        "recovery",
        "expected_input_digest"
      ],
      "additionalProperties": false
    },
    "GatewayAttemptReceipt": {
      "type": "object",
      "properties": {
        "contract_version": {
          "const": "harness-v1"
        },
        "stage": {
          "enum": [
            "act",
            "instruction_selection",
            "work_summary"
          ]
        },
        "binding_fingerprint": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "request_digest": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "logical_requests": {
          "const": 1
        },
        "backend_attempts": {
          "anyOf": [
            {
              "enum": [
                0,
                1
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "generation_state": {
          "enum": [
            "not_started",
            "terminal",
            "unknown"
          ]
        },
        "hidden_retry": {
          "const": false
        },
        "recovery_profile": {
          "enum": [
            "same_request",
            "terminal_output_once"
          ]
        },
        "recovery_profile_revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "applied_transformations": {
          "type": "array",
          "items": {
            "enum": [
              "format_suffix",
              "thinking_disabled"
            ]
          },
          "uniqueItems": true,
          "maxItems": 2
        },
        "usage_complete": {
          "type": "boolean"
        },
        "input_digest": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "contract_version",
        "stage",
        "binding_fingerprint",
        "request_digest",
        "logical_requests",
        "backend_attempts",
        "generation_state",
        "hidden_retry",
        "recovery_profile",
        "recovery_profile_revision",
        "applied_transformations",
        "usage_complete",
        "input_digest"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "generation_state": {
                "const": "not_started"
              }
            }
          },
          "then": {
            "properties": {
              "backend_attempts": {
                "const": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "generation_state": {
                "const": "terminal"
              }
            }
          },
          "then": {
            "properties": {
              "backend_attempts": {
                "const": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "generation_state": {
                "const": "unknown"
              }
            }
          },
          "then": {
            "properties": {
              "backend_attempts": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "recovery_profile": {
                "const": "same_request"
              }
            }
          },
          "then": {
            "properties": {
              "applied_transformations": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    },
    "MeasureExtension": {
      "type": "object",
      "properties": {
        "contract_version": {
          "const": "harness-v1"
